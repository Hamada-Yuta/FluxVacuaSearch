{
  "source": "data/selected_solutions.parquet",
  "environment": {
    "python": "3.11.3",
    "platform": "macOS-15.4.1-x86_64-i386-64bit",
    "packages": {
      "numpy": "2.0.0",
      "pandas": "3.0.0",
      "matplotlib": "3.10.3",
      "sklearn": "1.8.0",
      "xgboost": "3.0.5"
    }
  },
  "n_jobs": 2,
  "model_parameters": {
    "max_depth": 8,
    "learning_rate": 0.15,
    "min_child_weight": 5,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "random_state": 0,
    "tree_method": "hist",
    "n_jobs": 2,
    "objective": "binary:logistic",
    "eval_metric": "logloss"
  },
  "seeds": {
    "model": 0,
    "main_row_split": 0,
    "validation_split": 0,
    "whole_tuple_split": 0,
    "matched_train_subsample": 0,
    "matched_test_subsample": 1,
    "learning_subsamples": 0,
    "shap_sample": 0
  },
  "source_row_convention": "Zero-based physical Parquet row position; no reordering before splitting",
  "save_predictions": false,
  "statistical_unit": "equally weighted selected solution rows",
  "interpretation": "Retrospective classification conditional on the selected sample; not new-scan success or compute savings"
}
